# Test-only secrets for `npm run test:integration`.
# Requires local Supabase running first: `npx supabase start`.
#
# Copy this file to `.env.test.local` (gitignored) and fill in real values from:
#   npx supabase status -o env
#
# SUPABASE_SERVICE_ROLE_KEY is used ONLY by test setup (src/__tests__/setup/seed-users.ts)
# to create/delete throwaway test users and bypass RLS for seeding. It is never used by
# app code (src/) and must never be committed.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=###
SUPABASE_SERVICE_ROLE_KEY=###
