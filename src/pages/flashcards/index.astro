---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import FlashcardList from "@/components/flashcards/FlashcardList";
---

<Layout title="My flashcards">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          My flashcards
        </h1>
        <FlashcardList client:load />
      </div>
    </div>
  </div>
</Layout>
